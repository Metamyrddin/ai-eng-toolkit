  },
  "optimizer": {"type": "AdamW", "params": {"lr": 2e-5, "betas": [0.9, 0.95], "eps": 1e-8, "weight_decay": 0.1}},
  "steps_per_print": 10,
  "wall_clock_breakdown": false
}
